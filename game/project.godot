; Engine configuration file.
; Godot editörü bu dosyayı kendi biçimine göre yeniden yazabilir.

config_version=5

[application]

config/name="MathKings"
config/description="Matematik Krallığı - 9-12 yaş matematik macera oyunu"
config/version="0.1.0"
run/main_scene="res://scenes/boot/splash.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.16, 0.42, 0.29, 1)
config/icon="res://icon.svg"
config/quit_on_go_back=false

[autoload]

Settings="*res://autoload/settings.gd"
Cloud="*res://autoload/cloud.gd"
GameState="*res://autoload/game_state.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/custom="res://assets/ui/theme.tres"

